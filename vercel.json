{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Link": "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\""
      },
      "continue": true
    },
    {
      "src": "^/robots\\.txt$",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/llms(-full)?\\.txt$",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/(index\\.html)?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8"
      },
      "dest": "/llms.txt"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
